# ============================================
# CyberQuill Environment Variables
# ============================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the .env file to Git.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your real keys
# ============================================

# ---------- Groq API ----------
# Get your key from: https://console.groq.com/keys
# Used for: Classification Agent, Routing (fast, low-latency tasks)
GROQ_API_KEY=your_groq_api_key_here

# ---------- OpenRouter API ----------
# Get your key from: https://openrouter.ai/keys
# Used for: Writer Agent, Reviewer Agent (high-quality reasoning tasks)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ---------- Model Configuration ----------
# Groq model for fast tasks (classification, routing)
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter model for complex tasks (writing, review)
OPENROUTER_MODEL=meta-llama/llama-4-maverick

# ---------- ChromaDB ----------
# Directory where the vector database is stored
CHROMA_PERSIST_DIR=./chroma_db

# ---------- Logging ----------
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
